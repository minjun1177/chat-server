# Copy this file to .env and fill in what you need:
#
#     cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. config.py holds only the defaults below, so nothing
# personal ever has to be edited into a file that gets committed.
#
# A real environment variable always wins over this file, so a container or a
# systemd unit can override any of it. Personal settings that should apply to
# every checkout can also go in ~/.localchat/.env instead.

# ─── Discord bot ────────────────────────────────────────────────────────────
# The token from the developer portal (Bot → Reset Token). Required by bot.py.
DISCORD_BOT_TOKEN=

# Who may use the bot. Ids, comma or space separated. Right-click a user in
# Discord with Developer Mode on → Copy User ID.
#
# Owners get every tool, each still behind an approval button. Everyone else
# gets the read-only safe set. With both lists empty nobody can talk to it.
DISCORD_OWNER_IDS=
DISCORD_ALLOWED_USERS=

# Servers the bot answers in. Empty = every server it has been invited to.
DISCORD_ALLOWED_GUILDS=

# DISCORD_ALLOW_DM=true          # answer direct messages (allow-listed users only)
# DISCORD_ALLOW_EVERYONE=false   # true lets anyone talk to it, safe tools only
# DISCORD_MCP_FOR_EVERYONE=false # true moves mcp__* into the safe tool set
# DISCORD_TOKEN_ENV=DISCORD_BOT_TOKEN   # read the token from another variable

# One conversation per "channel", per "user", or per "channel+user".
# DISCORD_SESSION_SCOPE=channel

# Where the bot writes. Attachments and files the model produces go to the
# workspace; memories are one file per Discord user under the memory folder.
# DISCORD_WORKSPACE=workspace/discord
# DISCORD_MEMORY_DIR=memory
# DISCORD_SESSION_SUBDIR=discord

# Streaming and limits.
# DISCORD_EDIT_INTERVAL=1.2        # seconds between message edits
# DISCORD_MSG_LIMIT=1900           # characters per message
# DISCORD_MAX_MESSAGES=5           # after this many, the rest is sent as a file
# DISCORD_APPROVAL_TIMEOUT=180     # seconds an approval prompt waits for a click
# DISCORD_QUESTION_TIMEOUT=300     # seconds a question waits for an answer
# DISCORD_MAX_CONCURRENT_TURNS=3   # turns running at once across all channels
# DISCORD_SESSION_IDLE=21600       # seconds an idle conversation stays in memory

# ─── Model providers ────────────────────────────────────────────────────────
# Only the provider you actually use needs a key. /connect can also save one to
# ~/.localchat/providers.json, which is written owner-only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# ─── The harness itself ─────────────────────────────────────────────────────
# LOCALCHAT_MODEL=gemma4:e4b
# LOCALCHAT_REPLY_LANGUAGE=          # empty = answer in the language the user wrote in
# LOCALCHAT_TIMEZONE=Asia/Seoul      # clock shown to the model; empty = this machine's zone
# LOCALCHAT_NUM_CTX=32768
# LOCALCHAT_NUM_PREDICT=4096
# LOCALCHAT_MAX_TOOL_CALLS=10
# LOCALCHAT_SESSION_DIR=sessions
# LOCALCHAT_MEMORY_FILE=memory.json
# LOCALCHAT_MCP=true                 # false starts without any MCP server
# LOCALCHAT_PERMISSIONS=true         # false ignores the permission rule files
# SEARXNG_URL=                       # a self-hosted SearXNG for fully local search

# ─── Logging ────────────────────────────────────────────────────────────────
# Three layers, each including the one above it:
#   error    something failed, or was refused
#   tool     + every tool call, who asked for it, and every approval decision
#   request  + every message and command that reached the bot
#   debug    + the harness talking to itself, and discord.py's own logs
# LOG_LEVEL=tool
#
# LOG_FILE=logs/bot.log     # also write there, rotating at 2MB, keeping 3
# LOG_PREVIEW=120           # characters of a message to log; 0 logs only its length

# ─── Anything an MCP server needs ───────────────────────────────────────────
# ${VAR} in .mcp.json is filled from here too.
# GITHUB_TOKEN=
